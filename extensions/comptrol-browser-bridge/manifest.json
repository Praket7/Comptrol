{
  "manifest_version": 3,
  "name": "Comptrol Browser Bridge",
  "version": "0.1.0",
  "description": "Production-ready bridge between Comptrol runtime and existing signed-in Chrome sessions. Enables exact target identity, CDP attachment to existing tabs, tab group management, and closed session recovery without profile copying.",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "sessions",
    "storage",
    "alarms",
    "nativeMessaging",
    "scripting",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Comptrol Browser Bridge",
    "default_popup": "src/popup.html"
  },
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}
