{
  "manifest_version": 3,
  "name": "Comptrol Browser Bridge",
  "version": "0.1.0",
  "description": "Local browser bridge for Comptrol. Debugger access can inspect/control pages. Site DOM access is requested separately per site; review Chrome's warnings before granting.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "sessions",
    "storage",
    "alarms",
    "nativeMessaging",
    "downloads",
    "offscreen"
  ],
  "optional_permissions": ["scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Comptrol Browser Bridge",
    "default_popup": "src/popup.html"
  },
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}
