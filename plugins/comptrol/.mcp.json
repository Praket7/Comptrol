{
  "mcpServers": {
    "comptrol-local": {
      "command": "node",
      "args": ["scripts/launch-comptrol-mcp.cjs"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "COMPTROL_ALLOW_BROWSER_CDP": "1",
        "COMPTROL_ALLOW_WINDOWS_UIA": "1",
        "COMPTROL_WINDOWS_UIA": "1",
        "COMPTROL_AUTO_START_CHROME_CDP": "0"
      }
    }
  }
}
