{
  "task_id": "v5.adapter_matrix",
  "benchmark_suite": "adapter",
  "goal": "Verify all 14 adapters respond to handshake, capabilities, and describe-class commands.",
  "timeout_ms": 60000,
  "initial_state": "fresh Comptrol state directory",
  "required_capabilities": ["adapter.handshake", "adapter.capabilities", "adapter.describe"],
  "tasks": [
    {
      "task_id": "v5.adapter.resolve_handshake",
      "goal": "Resolve adapter handshake and verify provider metadata.",
      "iterations": 2,
      "verifier": "contains_provider_metadata",
      "steps": [
        {"method": "adapter.resolve", "params": {"action": "handshake"}}
      ]
    },
    {
      "task_id": "v5.adapter.capabilities_all",
      "goal": "Request capabilities from all adapters and verify non-empty result.",
      "iterations": 1,
      "verifier": "capabilities_non_empty",
      "steps": [
        {"method": "adapter.capabilities", "params": {}}
      ]
    },
    {
      "task_id": "v5.adapter.describe_all",
      "goal": "Describe all adapters and verify the result is a non-empty map.",
      "iterations": 1,
      "verifier": "descriptions_non_empty",
      "steps": [
        {"method": "adapter.describe", "params": {}}
      ]
    }
  ],
  "final_verifier": "all task verifiers pass"
}