{
  "task_id": "v5.browser_matrix",
  "benchmark_suite": "browser",
  "goal": "Verify browser-fixture tasks against the local fixture with independent verifiers.",
  "timeout_ms": 60000,
  "initial_state": "fresh Comptrol state directory with browser fixture loaded",
  "required_capabilities": ["browser.session", "browser.cdp.dialog"],
  "tasks": [
    {
      "task_id": "v5.browser.ensure_state_reuse",
      "goal": "Confirm repeated ensure_state calls reuse the existing session without a page reload.",
      "iterations": 3,
      "verifier": "session_id_no_reload",
      "steps": [
        {"method": "browser.session.ensure_state", "params": {"target": "fixture://browser/index.html", "action": "ensure_state"}}
      ]
    },
    {
      "task_id": "v5.browser.spa_navigation",
      "goal": "Navigate a single-page fixture and verify the DOM target updates without full reload.",
      "iterations": 3,
      "verifier": "navigation_spa",
      "steps": [
        {"method": "browser.session.ensure_state", "params": {"target": "fixture://browser/index.html", "action": "ensure_state"}},
        {"method": "browser.cdp.navigate", "params": {"target": "fixture://browser/index.html", "url": "fixture://browser/spa.html"}}
      ]
    },
    {
      "task_id": "v5.browser.dialog_handling",
      "goal": "Open a fixture dialog and verify the dialog handler routes the alert correctly.",
      "iterations": 3,
      "verifier": "dialog_handled",
      "steps": [
        {"method": "browser.session.ensure_state", "params": {"target": "fixture://browser/index.html", "action": "ensure_state"}},
        {"method": "browser.cdp.dialog", "params": {"target": "fixture://browser/index.html", "dialog_type": "alert", "message": "test"}}
      ]
    }
  ],
  "final_verifier": "all task verifiers pass"
}