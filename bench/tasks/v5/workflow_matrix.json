{
  "task_id": "v5.workflow_matrix",
  "benchmark_suite": "workflow",
  "goal": "Measure cold plan, trace compile, and warm replay with model-turn counting.",
  "timeout_ms": 120000,
  "initial_state": "fresh Comptrol state directory",
  "required_capabilities": ["workflow.execute", "trace.compile", "trace.replay"],
  "tasks": [
    {
      "task_id": "v5.workflow.cold_plan",
      "goal": "Execute a cold workflow plan and verify the plan is compiled.",
      "iterations": 1,
      "verifier": "has_plan_id",
      "steps": [
        {"method": "workflow.execute", "params": {"plan": "test_plan", "mode": "cold"}}
      ]
    },
    {
      "task_id": "v5.workflow.trace_compile",
      "goal": "Compile a verified trace from the plan and verify the trace ID.",
      "iterations": 2,
      "verifier": "has_trace_id",
      "steps": [
        {"method": "trace.compile", "params": {"plan_id": "test_plan"}}
      ]
    },
    {
      "task_id": "v5.workflow.warm_replay",
      "goal": "Replay a compiled trace in warm mode with zero model turns by construction.",
      "iterations": 2,
      "verifier": "replayed_true_model_turns_zero",
      "steps": [
        {"method": "trace.replay", "params": {"trace_id": "compiled_trace", "mode": "warm"}}
      ]
    }
  ],
  "final_verifier": "all task verifiers pass"
}