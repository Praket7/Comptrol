{
  "task_id": "v5.workflow_matrix",
  "benchmark_suite": "workflow",
  "goal": "Verify the public bounded workflow VM, independent verification, idempotent replay, and assertion failure behavior.",
  "timeout_ms": 120000,
  "initial_state": "fresh Comptrol state directory",
  "required_capabilities": [
    "tools/call"
  ],
  "tasks": [
    {
      "task_id": "v5.workflow.execute_verified",
      "goal": "Execute a bounded workflow and verify its returned application state.",
      "iterations": 2,
      "verifier": "workflow_done_verified",
      "steps": [
        {
          "method": "tools/call",
          "params": {
            "name": "operate",
            "arguments": {
              "intent": "workflow.execute",
              "params": {
                "ops": [
                  {
                    "op": "sense",
                    "key": "ready",
                    "value": true
                  },
                  {
                    "op": "assert",
                    "key": "ready",
                    "equals": true
                  },
                  {
                    "op": "return",
                    "value": {
                      "done": true
                    }
                  }
                ]
              },
              "idempotency_key": "bench-workflow-execute-001"
            }
          }
        }
      ]
    },
    {
      "task_id": "v5.workflow.idempotent_replay",
      "goal": "Repeat one workflow request with the same idempotency key and verify the second delivery is a replay rather than a duplicate execution.",
      "iterations": 2,
      "verifier": "idempotent_replay_verified",
      "steps": [
        {
          "method": "tools/call",
          "params": {
            "name": "operate",
            "arguments": {
              "intent": "workflow.execute",
              "params": {
                "ops": [
                  {
                    "op": "return",
                    "value": {
                      "done": true
                    }
                  }
                ]
              },
              "idempotency_key": "bench-workflow-replay-001"
            }
          }
        },
        {
          "method": "tools/call",
          "params": {
            "name": "operate",
            "arguments": {
              "intent": "workflow.execute",
              "params": {
                "ops": [
                  {
                    "op": "return",
                    "value": {
                      "done": true
                    }
                  }
                ]
              },
              "idempotency_key": "bench-workflow-replay-001"
            }
          }
        }
      ]
    },
    {
      "task_id": "v5.workflow.assertion_failure",
      "goal": "Fail a workflow assertion and verify the failure is explicit rather than silently treated as success.",
      "iterations": 1,
      "verifier": "response_has_error_code",
      "verifier_expected": "verification_failed",
      "steps": [
        {
          "method": "tools/call",
          "params": {
            "name": "operate",
            "arguments": {
              "intent": "workflow.execute",
              "params": {
                "ops": [
                  {
                    "op": "sense",
                    "key": "ready",
                    "value": false
                  },
                  {
                    "op": "assert",
                    "key": "ready",
                    "equals": true
                  }
                ]
              },
              "idempotency_key": "bench-workflow-fail-001"
            }
          }
        }
      ]
    }
  ],
  "final_verifier": "all task verifiers pass"
}
