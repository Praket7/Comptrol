{
  "task_id": "v5.desktop_matrix",
  "benchmark_suite": "desktop",
  "goal": "Measure desktop resolution, permission, and popup classification tasks against local fixtures and live macOS where safe.",
  "timeout_ms": 60000,
  "initial_state": "fresh Comptrol state directory",
  "required_capabilities": ["desktop.resolve", "desktop.permission", "popup.inspect"],
  "tasks": [
    {
      "task_id": "v5.desktop.app_resolve",
      "goal": "Resolve a known local application by bundle id and verify the path exists.",
      "iterations": 3,
      "verifier": "resolved_true_path_nonempty",
      "steps": [
        {"method": "desktop.resolve", "params": {"bundle_id": "com.apple.TextEdit"}}
      ]
    },
    {
      "task_id": "v5.desktop.app_list",
      "goal": "List installed applications and verify the result is a non-empty array.",
      "iterations": 2,
      "verifier": "apps_array_nonempty",
      "steps": [
        {"method": "desktop.list", "params": {}}
      ]
    },
    {
      "task_id": "v5.desktop.permission_status",
      "goal": "Check accessibility permission status; record honestly if unavailable.",
      "iterations": 1,
      "verifier": "has_status_field",
      "steps": [
        {"method": "desktop.permission.status", "params": {"permission": "accessibility"}}
      ]
    },
    {
      "task_id": "v5.desktop.popup_classify",
      "goal": "Classify a fixture popup window and verify the classification is one of the expected types.",
      "iterations": 2,
      "verifier": "classification_in_allowed",
      "steps": [
        {"method": "popup.inspect", "params": {"window_id": "fixture-popup-1"}}
      ]
    }
  ],
  "final_verifier": "all task verifiers pass"
}