{
  "task_id": "v5.desktop_matrix",
  "benchmark_suite": "desktop",
  "goal": "Measure app resolution, permission, and popup classification tasks against local fixtures and live macOS where safe.",
  "timeout_ms": 60000,
  "initial_state": "fresh Comptrol state directory",
  "required_capabilities": ["tools/call"],
  "tasks": [
    {
      "task_id": "v5.desktop.app_resolve",
      "goal": "Resolve a known local application by identity and verify the path exists.",
      "iterations": 3,
      "verifier": "resolved_true_path_nonempty",
      "steps": [
        {"method": "tools/call", "params": {"name": "operate", "arguments": {"intent": "app.resolve", "params": {"app": "python3"}, "idempotency_key": "bench-desktop-resolve-001"}}}
      ]
    },
    {
      "task_id": "v5.desktop.app_list",
      "goal": "List installed applications and verify the result is a non-empty array.",
      "iterations": 2,
      "verifier": "apps_array_nonempty",
      "steps": [
        {"method": "tools/call", "params": {"name": "operate", "arguments": {"intent": "app.list", "params": {}, "idempotency_key": "bench-desktop-list-001"}}}
      ]
    },
    {
      "task_id": "v5.desktop.permission_status",
      "goal": "Check permission status; record honestly if unavailable.",
      "iterations": 1,
      "verifier": "has_status_field",
      "steps": [
        {"method": "tools/call", "params": {"name": "operate", "arguments": {"intent": "permission.status", "params": {"permission": "accessibility"}, "idempotency_key": "bench-desktop-perm-001"}}}
      ]
    },
    {
      "task_id": "v5.desktop.popup_classify",
      "goal": "Classify a fixture popup window and verify the classification is one of the expected types.",
      "iterations": 2,
      "verifier": "classification_in_allowed",
      "steps": [
        {"method": "tools/call", "params": {"name": "operate", "arguments": {"intent": "popup.inspect", "params": {"window_id": "fixture-popup-1"}, "idempotency_key": "bench-desktop-popup-001"}}}
      ]
    }
  ],
  "final_verifier": "all task verifiers pass"
}
